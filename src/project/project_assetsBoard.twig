                    </div>                
                    {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
                    <div class="custom-control custom-switch mb-3">
                        <input type="checkbox" class="custom-control-input" id="quickDispatchFreeScan">
                        <label class="custom-control-label" for="quickDispatchFreeScan">
                            Free Scan
                            <small class="text-muted d-block">Allow assets that are not in the planned requirements to be added to this project.</small>
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="quickDispatchSection">Place newly added items under</label>
                        <select class="form-control" id="quickDispatchSection">
                            <option value="">Automatic placement</option>
                            {% for section in project.assetRequirementSectionOptions %}<option value="{{ section.id }}">{{ section.path }}</option>{% endfor %}
                        </select>
                    </div>
                    {% endif %}
                    <div class="form-group">
                        <label>Asset Tag or Barcode</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="assetTagQuickDispatch" />
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="goQuickDispatch">
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="assetTagResultQuickDispatch"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="barcodeDispatchModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Barcode Dispatch</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    {% if FINANCIALS.assetsAssigned|length > 0 or project.assetRequirements|length > 0 %}
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="pill" href="#barcode-dispatch-modal-board-thisinstance" role="tab" aria-controls="barcode-dispatch-modal-board-thisinstance" aria-selected="true">{{ USERDATA.instance.instances_name }}</a>
                        </li>
                    {% endif %}
                    {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <li class="nav-item">
                            <a class="nav-link{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} active{% endif %}" data-toggle="pill" href="#barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" role="tab" aria-controls="barcode-dispatch-modal-board-instance{{ instance['instance'].instances_id }}" aria-selected="false">{{  instance['instance'].instances_name }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <div class="p-3">
                    <div class="tab-content">
                        {% if FINANCIALS.assetsAssigned|length > 0 or project.assetRequirements|length > 0 %}
                        <div class="tab-pane show active p2" id="barcode-dispatch-modal-board-thisinstance" role="tabpanel">
                            <p>Scan a barcode for an asset from {{ USERDATA.instance.instances_name }} to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorBarcodeDispatch" data-instanceid="{{ USERDATA.instance["instances_id"] }}">
                                    {% for status in BOARDSTATUSES[USERDATA.instance["instances_id"]] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% endif %}
                        {% for instance in FINANCIALS.assetsAssignedSUB %}
                        <div class="tab-pane p2{% if FINANCIALS.assetsAssigned|length == 0 and loop.first %} show active{% endif %}" id="barcode-dispatch-modal-board-instance{{ instance['instance']['instances_id'] }}">
                            <p>Scan a barcode for an asset from {{  instance['instance'].instances_name }} to set its status.</p>
                            <div class="form-group">
                                <label>Set Asset Status to</label>
                                <select class="form-control assetStatusSelectorBarcodeDispatch" data-instanceid="{{ instance['instance']['instances_id'] }}">
                                    {% for status in BOARDSTATUSES[instance['instance']['instances_id']] %}
                                    <option value="{{ status['assetsAssignmentsStatus_id'] }}">{{ status['assetsAssignmentsStatus_name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
                    <div class="custom-control custom-switch mb-3">
                        <input type="checkbox" class="custom-control-input" id="barcodeDispatchFreeScan">
                        <label class="custom-control-label" for="barcodeDispatchFreeScan">
                            Free Scan
                            <small class="text-muted d-block">Allow assets that are not in the planned requirements to be added to this project.</small>
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="barcodeDispatchSection">Place newly added items under</label>
                        <select class="form-control" id="barcodeDispatchSection">
                            <option value="">Automatic placement</option>
                            {% for section in project.assetRequirementSectionOptions %}<option value="{{ section.id }}">{{ section.path }}</option>{% endfor %}
                        </select>
                    </div>
                    {% endif %}
                    {% embed 'assets/widgets/barcodeScanner.twig' with {"scannerCallback": "dispatchBarcodeScanned", "scannerIdSuffix": "Dispatch"} %}
                    {% endembed %}
                    <div id="barcodeDispatchResult"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
    });

    if (localStorage.getItem("activeTab-board")) {
        $('a.assetsBoardToggle[href=\'#' + localStorage.getItem("activeTab-board") + '\']').tab('show');
    }

    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}

    // Whether the user can assign assets to projects (for Supermarket Sweep)
    const canAssignAssets = {{ "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions ? 'true' : 'false' }};
    var barcodeDispatchNeedsRefresh = false;

    function playNegativeScanSound() {
        try {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            const context = new AudioContextClass();
            const oscillator = context.createOscillator();
            const gain = context.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(220, context.currentTime);
            oscillator.frequency.exponentialRampToValueAtTime(80, context.currentTime + 0.28);
            gain.gain.setValueAtTime(0.25, context.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, context.currentTime + 0.3);
            oscillator.connect(gain);
            gain.connect(context.destination);
            oscillator.start();
            oscillator.stop(context.currentTime + 0.3);
            oscillator.onended = function () { context.close(); };
        } catch (error) {
            console.warn('Could not play scan rejection sound', error);
        }
    }

    function showBarcodeDispatchError(value, message, resultTarget) {
        resultTarget = resultTarget || '#barcodeDispatchResult';
        playNegativeScanSound();
        Toast.fire({ type: 'error', title: value + ': ' + message });
        const resultDiv = $('<div>')
            .addClass('alert alert-danger py-2 mb-2')
            .text(value + ': ' + message)
            .delay(5000)
            .fadeOut(500, function () { $(this).remove(); });
        $(resultTarget).prepend(resultDiv);
    }

    // Create an array of status ids, ordered
    const assetStatusesRaw = JSON.parse('{{ BOARDSTATUSES|json_encode|raw }}');
    var assetStatuses = {};
    for (const [instanceid, instanceStatuses] of Object.entries(assetStatusesRaw)) {
        var newDir = {"orderedStatusIds": [], "allData": instanceStatuses};
        // In theory, if the statuses have been sorted by the user dragging them around then the orders will be in order and so JS will recognise them as an array. Otherwise they'll be an object (e.g. if someone has deleted a status but not dragged them around)
        if (Array.isArray(instanceStatuses)) {
            instanceStatuses.forEach((item) => {
                newDir["orderedStatusIds"].push(item["assetsAssignmentsStatus_id"]);
            });
        } else if (typeof instanceStatuses === 'object') {
            for (const [key, value] of Object.entries(instanceStatuses)) {
                newDir["orderedStatusIds"].push(value["assetsAssignmentsStatus_id"]);
            }
        }
        assetStatuses[instanceid] = newDir;
    }
    // Show/Hide relevant buttons for touchscreen control
    function drawButtons() {
        $('.assetDispatchAssetList').each(function(){
            var instance = $(this).data("instance");
            var statusid = $(this).data("statusid");
            var position = assetStatuses[instance]['orderedStatusIds'].indexOf(statusid);
            var prev = (position == 0 ? false : assetStatuses[instance]['orderedStatusIds'][position-1]);
            var next = (position == assetStatuses[instance]['orderedStatusIds'].length - 1 ? false : assetStatuses[instance]['orderedStatusIds'][position+1]);

            $(this).find(".assetDispatchAssetList-statusPrevButton").css('display', prev === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusPrevButton").data('nextstatus', prev);
            $(this).find(".assetDispatchAssetList-statusNextButton").css('display', next === false ? 'none': 'block');
            $(this).find(".assetDispatchAssetList-statusNextButton").data('nextstatus', next);
        });
    }
    /**
     * Function to change the status of an asset assignment
     * @param assetsAssignments_id Id of the AssetAssignment
     * @param assetsAssignments_status new status id of the AssetAssignment
     */
    function changeStatus(assetsAssignments_id, assetsAssignments_status) {
        ajaxcall("projects/assets/setStatus.php", {"assetsAssignments_id":assetsAssignments_id, "assetsAssignments_status":assetsAssignments_status}, function (returned) {
            drawButtons();
            Toast.fire({
                type: 'success',
                title: 'Asset Status Updated'
            });
        });
    }
    /**
     * Function to handle a barcode scan for asset dispatch
     * Called by the shared barcode scanner widget
     * @param value The barcode value
     * @param type The barcode format type (e.g. 'QR_CODE', 'CODE_128', or 'UNKNOWN' for USB/Bluetooth)
     */
    function dispatchBarcodeScanned(value, type) {
        var assetStatus = $(".assetStatusSelectorBarcodeDispatch:visible").val();
        var instanceId = $(".assetStatusSelectorBarcodeDispatch:visible").data("instanceid");
        var requestData = {
            text: value,
            assetsAssignments_status: assetStatus,
            projects_id: {{ project.projects_id }},
            instances_id: instanceId,
            freeScan: $('#barcodeDispatchFreeScan').is(':checked') ? '1' : '0'
        };
        if (type && type !== "UNKNOWN") {
            requestData.type = type;
        }
        $.ajax({
            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusBarcode.php",
            type: "POST",
            data: requestData,
            cache: false,
            success: function(result, status, data) {
                if (result.result === true) {
                    var assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-asset=" + result.response.assets_id + "]");
                    assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
                    drawButtons();
                    barcodeDispatchNeedsRefresh = true;
                    Toast.fire({
                        type: 'success',
                        title: 'Asset dispatched via barcode'
                    });
                } else if (result.error && result.error.code === "NOTASSIGNED" && ('assets_id' in result.error) && canAssignAssets) {
                    // Required assets, or any asset in Free Scan mode, are assigned immediately.
                    if (window.barcodeAssignInProgress) {
                        return;
                    }
                    window.barcodeAssignInProgress = true;
                    $.ajax({
                                    url: "{{ CONFIG.ROOTURL }}/api/projects/assets/assign.php",
                                    type: "POST",
                                    data: {
                                        projects_id: {{ project.projects_id }},
                                        assets_id: result.error.assets_id,
                                        projectAssetRequirementSections_id: $('#barcodeDispatchSection').val()
                                    },
                                    cache: false,
                                    success: function(assignResult) {
                                        if (assignResult.result === true) {
                                            // Asset assigned, now set its status via barcode dispatch
                                            $.ajax({
                                                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusBarcode.php",
                                                type: "POST",
                                                data: requestData,
                                                cache: false,
                                                success: function(retryResult) {
                                                    if (retryResult.result === true) {
                                                        Toast.fire({
                                                            type: 'success',
                                                            title: 'Asset added to project and dispatched via barcode'
                                                        });
                                                        window.barcodeAssignInProgress = false;
                                                        barcodeDispatchNeedsRefresh = true;
                                                    } else {
                                                        Toast.fire({
                                                            type: 'warning',
                                                            title: 'Asset added to project but status could not be updated'
                                                        });
                                                        window.barcodeAssignInProgress = false;
                                                        barcodeDispatchNeedsRefresh = true;
                                                    }
                                                },
                                                error: function() {
                                                    Toast.fire({
                                                        type: 'warning',
                                                        title: 'Asset added to project but status could not be updated'
                                                    });
                                                    window.barcodeAssignInProgress = false;
                                                    barcodeDispatchNeedsRefresh = true;
                                                }
                                            });
                                        } else {
                                            var assignErrorMsg = assignResult.error ? assignResult.error.message : "Could not assign asset to project";
                                            showBarcodeDispatchError(value, assignErrorMsg);
                                            window.barcodeAssignInProgress = false;
                                        }
                                    },
                                    error: function() {
                                        window.barcodeAssignInProgress = false;
                                        bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection');
                                    }
                                });
                } else {
                    var errorMsg = (result.error && result.error.message) ? result.error.message : "Barcode not found or asset not assigned to project";
                    showBarcodeDispatchError(value, errorMsg);
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.log(jqXHR, textStatus, errorThrown);
                bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection', function () {
                    location.reload();
                });
            }
        });
    }
    {% endif %}
    $(document).ready(function () {
        {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
        // Keep the shared dispatch modals outside tab panes so Assets List shortcuts can open them.
        $('#quickDispatchModal, #barcodeDispatchModal').appendTo(document.body);
        drawButtons();
        $('#barcodeDispatchModal').on('hidden.bs.modal', function () {
            if (barcodeDispatchNeedsRefresh) location.reload();
        });
        $('#quickDispatchModal').on('hidden.bs.modal', function () {
            if (barcodeDispatchNeedsRefresh) location.reload();
        });
        $(".assetDispatchAssetList").sortable({
            connectWith: "div",
            update: function( event, ui ){
                /*
                Update function is called twice, once for the old list and once for the new list.
                The lists, this, have a data attribute, status, that can be compared with each asset, ui.item[0].
                If the groupStatus is the same as the old status, this call can be ignored as this is the old list update call.
                Function call will refresh the page and sort any graphical issues.
                 */
                const groupStatus = this.dataset.statusid;
                const assetOldStatus = ui.item[0].dataset.currentstatus;
                const assetAssignment = ui.item[0].dataset.assignment;

                if (assetOldStatus !== groupStatus) {
                    changeStatus(parseInt(assetAssignment),parseInt(groupStatus));
                    ui.item[0].dataset.currentstatus = groupStatus;
                }
            }
        });

        $(".assetDispatchAssetList-statusPrevButton,.assetDispatchAssetList-statusNextButton").click(function (){
            const assetCard = $(this).parent();
            const assetAssignment = assetCard.data("assignment");
            const assetNextStatus = $(this).data("nextstatus");
            changeStatus(parseInt(assetAssignment),parseInt(assetNextStatus));
            //move card to new status
            assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetNextStatus + "][data-instance=" + assetCard.data("instance") + "]");
        });

        function doQuickDispatch() {
            const assetTag = $("#assetTagQuickDispatch").val();
            if (!assetTag || window.quickDispatchInProgress) return;
            const assetStatus = $(".assetStatusSelectorQuickDispatch:visible").val();
            const instanceId = $(".assetStatusSelectorQuickDispatch:visible").data("instanceid");
            const requestData = {
                text: assetTag,
                assetsAssignments_status: assetStatus,
                projects_id: {{ project.projects_id }},
                freeScan: $('#quickDispatchFreeScan').is(':checked') ? '1' : '0'
            };
            window.quickDispatchInProgress = true;
            // Not using ajaxcall so we can have our own error handling for the alert boxes
            $.ajax({
                url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusByTag.php",
                type: "POST",
                data: requestData,
                cache: false,
                success: function(result, status, data) {
                    if (result.result === true) {
                        const assetCard = $(".assetDispatchAssetList[data-instance=" + instanceId + "] .assetDispatchAssetList-card[data-asset=" + result.response.assets_id + "]");
                        assetCard.detach().appendTo(".assetDispatchAssetList[data-statusid=" + assetStatus + "][data-instance=" + instanceId + "]");
                        drawButtons();
                        barcodeDispatchNeedsRefresh = true;
                        window.quickDispatchInProgress = false;
                    } else if (result.error && result.error.code === 'NOTASSIGNED' && result.error.assets_id && canAssignAssets) {
                        $.ajax({
                            url: "{{ CONFIG.ROOTURL }}/api/projects/assets/assign.php",
                            type: "POST",
                            data: { projects_id: {{ project.projects_id }}, assets_id: result.error.assets_id, projectAssetRequirementSections_id: $('#quickDispatchSection').val() },
                            cache: false,
                            success: function (assignResult) {
                                if (assignResult.result === true) {
                                    $.ajax({
                                        url: "{{ CONFIG.ROOTURL }}/api/projects/assets/setStatusByTag.php",
                                        type: "POST",
                                        data: requestData,
                                        cache: false,
                                        success: function (retryResult) {
                                            if (retryResult.result === true) {
                                                Toast.fire({ type: 'success', title: assetTag + ': added to project' });
                                                barcodeDispatchNeedsRefresh = true;
                                            } else {
                                                showBarcodeDispatchError(assetTag, 'Asset added, but its status could not be updated', '#assetTagResultQuickDispatch');
                                                barcodeDispatchNeedsRefresh = true;
                                            }
                                            window.quickDispatchInProgress = false;
                                        },
                                        error: function () {
                                            showBarcodeDispatchError(assetTag, 'Asset added, but its status could not be updated', '#assetTagResultQuickDispatch');
                                            barcodeDispatchNeedsRefresh = true;
                                            window.quickDispatchInProgress = false;
                                        }
                                    });
                                } else {
                                    showBarcodeDispatchError(assetTag, assignResult.error ? assignResult.error.message : 'Could not assign asset to project', '#assetTagResultQuickDispatch');
                                    window.quickDispatchInProgress = false;
                                }
                            },
                            error: function () {
                                showBarcodeDispatchError(assetTag, 'Connection error', '#assetTagResultQuickDispatch');
                                window.quickDispatchInProgress = false;
                            }
                        });
                    } else {
                        playNegativeScanSound();
                        Toast.fire({ type: 'error', title: assetTag + ': ' + result.error.message });
                        const resultDiv = $('<div>')
                            .addClass('alert alert-danger py-2 mb-2')
                            .text(assetTag + ': ' + result.error.message)
                            .delay(5000)
                            .fadeOut(500, function () { $(this).remove(); });
                        $('#assetTagResultQuickDispatch').prepend(resultDiv);
                        window.quickDispatchInProgress = false;
                    }
                    $("#assetTagQuickDispatch").val("");
                    $("#assetTagQuickDispatch").focus();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    window.quickDispatchInProgress = false;
                    console.log(jqXHR, textStatus, errorThrown);
                    console.log("Connection Error");
                    bootbox.alert('Sorry we couldn\'t connect to the internet - please check your connection', function () {
                        location.reload();
                    });
                }
            });
        }
        $("#assetTagQuickDispatch").on("keydown", function(e) {
            if (e.key !== "Enter") {
                return;
            }
            e.preventDefault();
            doQuickDispatch();
        });
        $("#goQuickDispatch").on("click", doQuickDispatch);
        {% endif %}


        $('a.assetsBoardToggle[data-toggle="pill"]').on('click', function (e) {
            localStorage.setItem("activeTab-board", e.target.getAttribute('aria-controls'));
        })
    });
</script>
