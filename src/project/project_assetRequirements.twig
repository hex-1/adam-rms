                    const childDepth = (parseInt(requirementRow.attr('data-depth'), 10) || 0) + 1 + (asset.linkedDepth || 0);
                    childRow.append($('<td class="projectAssetNestedContent">').css({'--asset-guide-left': (0.75 + ((childDepth - 1) * 1.25)) + 'rem', 'padding-left': (0.75 + (childDepth * 1.25)) + 'rem'}).append(
