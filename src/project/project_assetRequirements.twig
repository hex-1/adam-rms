        {% if project.projectsTypes_config_finance == 1 and "PROJECTS:PROJECT_ASSETS:EDIT:CUSTOM_PRICE"|instancePermissions and "PROJECTS:PROJECT_ASSETS:EDIT:DISCOUNT"|instancePermissions %}
        $('#projectAssetRequirementsTableBody').on('click', '.projectAssetRequirementPriceEditable', function () {
            const cell = $(this);
            if (cell.find('input').length) return;
            const row = cell.closest('[data-kind="requirement"]');
            const isDiscount = cell.hasClass('projectAssetRequirementDiscount');
            const originalText = cell.text();
            const input = $('<input class="form-control form-control-sm" inputmode="decimal">')
                .attr({type: isDiscount ? 'number' : 'text', min: isDiscount ? 0 : null, max: isDiscount ? 100 : null, step: isDiscount ? 0.01 : null})
                .val(isDiscount ? row.attr('data-discount') : row.attr('data-period-price'));
            cell.empty().append(input);
            input.trigger('focus').select();
            let finished = false;
            function finishInlineEdit(save) {
                if (finished) return;
                finished = true;
                if (!save) return cell.text(originalText);
                const value = parseFloat(input.val());
                if (!Number.isFinite(value) || value < 0 || (isDiscount && value > 100)) {
                    finished = false;
                    input[0].reportValidity();
                    return;
                }
                const unitPrice = isDiscount ? parseFloat(row.attr('data-period-price')) : value;
                const discount = isDiscount ? value : parseFloat(row.attr('data-discount'));
                ajaxcall('projects/assets/editRequirement.php', {
                    projectAssetRequirements_id: parseInt(row.attr('data-id'), 10),
                    periodPrice: unitPrice,
                    discount: discount
                }, function () {
                    const quantity = parseInt(row.attr('data-required'), 10) || 0;
                    const formatMoney = new Intl.NumberFormat(undefined, {style: 'currency', currency: '{{ USERDATA.instance.instances_config_currency }}'});
                    const totalPrice = unitPrice * quantity * (1 - discount / 100);
                    row.attr('data-period-price', unitPrice).attr('data-discount', discount).attr('data-total-price', totalPrice);
                    row.find('.projectAssetRequirementUnitPrice').text(formatMoney.format(unitPrice));
                    row.find('.projectAssetRequirementDiscount').text(discount.toFixed(2) + '%');
                    row.find('.projectAssetRequirementTotalPrice').text(formatMoney.format(totalPrice));
                    window.refreshAssetRequirementSectionPackedTotals();
                }, false);
            }
            input.on('keydown', function (event) {
                if (event.key === 'Enter') { event.preventDefault(); finishInlineEdit(true); }
                if (event.key === 'Escape') { event.preventDefault(); finishInlineEdit(false); }
            }).on('blur', function () { finishInlineEdit(true); });
        });
