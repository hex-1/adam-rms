                    Object.keys(requirements).forEach(function (id) { loadAssetRequirementEditor(parseInt(id, 10)); });
                }, false);
            });
        });
        $('.projectAssetBulkDeleteRequirements').on('click', function () {
            const rows = selectedProjectRequirementRows();
            if (!rows.length) return;
            const ids = rows.map(function () { return parseInt($(this).attr('data-id'), 10); }).get();
            bootbox.confirm('Delete ' + ids.length + ' selected planned requirement' + (ids.length === 1 ? '' : 's') + '? Unpacked allocated assets will be unassigned. Requirements containing packed or later assets will be protected.', function (confirmed) {
                if (!confirmed) return;
                const assignments = [];
                // Preflight every requirement before removing anything. A packed
                // item therefore aborts the batch before the job is half changed.
                const preflight = function (index) {
                    if (index >= ids.length) return unassignAndDelete();
                    ajaxcall('projects/assets/deleteRequirement.php', {projectAssetRequirements_id: ids[index]}, function (data) {
                        (data.response.assignmentsToRemove || []).forEach(function (id) { if (assignments.indexOf(id) === -1) assignments.push(id); });
                        preflight(index + 1);
                    }, false);
                };
                const finalize = function (index) {
                    if (index >= ids.length) {
                        rows.each(function () {
                            const row = $(this);
                            $('#projectAssetRequirementsTableBody > .projectAssetPhysicalAsset[data-requirement-id="' + row.attr('data-id') + '"]').remove();
                            row.remove();
                        });
                        window.refreshAssetRequirementSectionPackedTotals();
                        refreshProjectAssetBulkSelection();
                        return;
                    }
                    ajaxcall('projects/assets/deleteRequirement.php', {projectAssetRequirements_id: ids[index], finalize: 1}, function () { finalize(index + 1); }, false);
                };
                const unassignAndDelete = function () {
                    if (!assignments.length) return finalize(0);
                    ajaxcall('projects/assets/unassign.php', {assetsAssignments: assignments}, function () { finalize(0); }, false);
                };
                preflight(0);
            });
        });
        // Individual row actions deliberately expose only adjacent workflow
        // states plus the convenient jump to Packed.
        function buildRequirementAssetActions(asset) {
            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions or "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
            const dropdown = $('<div class="dropdown">');
            dropdown.append('<button class="btn btn-sm btn-link text-muted" type="button" data-toggle="dropdown" aria-label="Asset actions"><i class="fas fa-ellipsis-v"></i></button>');
            const menu = $('<div class="dropdown-menu dropdown-menu-right">');
            const options = [];
            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
            const rawStatuses = requirementAssetStatuses[asset.instances_id] || [];
            const statuses = Object.keys(rawStatuses).map(function (key) { return rawStatuses[key]; });
            const currentIndex = statuses.findIndex(function (status) {
                return parseInt(status.assetsAssignmentsStatus_id, 10) === parseInt(asset.assetsAssignmentsStatus_id, 10);
            });
            const packedIndex = statuses.findIndex(function (status) {
                return String(status.assetsAssignmentsStatus_name || '').toLowerCase() === 'packed';
            });
            if (currentIndex > 0) options.push({direction: 'Previous', icon: 'fa-arrow-left', status: statuses[currentIndex - 1]});
            if (currentIndex < statuses.length - 1) options.push({direction: 'Next', icon: 'fa-arrow-right', status: statuses[currentIndex + 1]});
            if (packedIndex > currentIndex + 1) options.push({direction: 'Jump to', icon: 'fa-box', status: statuses[packedIndex]});
            options.forEach(function (option) {
                const status = option.status;
                const item = $('<button class="dropdown-item setRequirementAssetStatus" type="button">')
                    .attr('data-assignment-id', asset.assetsAssignments_id)
                    .attr('data-status-id', status.assetsAssignmentsStatus_id)
                    .attr('data-status-name', status.assetsAssignmentsStatus_name);
                item.append('<i class="fas ' + option.icon + ' mr-2"></i>');
                item.append(document.createTextNode(option.direction + ': ' + status.assetsAssignmentsStatus_name));
                menu.append(item);
            });
            {% endif %}
            {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
            if (options.length) menu.append('<div class="dropdown-divider"></div>');
            menu.append($('<button class="dropdown-item editProjectPhysicalAsset" type="button"><i class="fas fa-edit mr-2"></i>Edit asset</button>')
                .attr('data-assignment-id', asset.assetsAssignments_id));
            const remove = $('<button class="dropdown-item text-danger removeProjectPhysicalAsset" type="button"><i class="fas fa-unlink mr-2"></i>Remove from job</button>')
                .attr('data-assignment-id', asset.assetsAssignments_id)
                .prop('disabled', !asset.canRemove);
            if (!asset.canRemove) remove.attr('title', asset.isLinkedAsset ? 'Linked accessories are managed through their parent asset' : 'Packed assets and later statuses cannot be removed');
            menu.append(remove);
            {% endif %}
            return dropdown.append(menu);
            {% else %}
            return $();
            {% endif %}
        }
