                requirementRow.find('.projectAssetRequirementToggle').prop('disabled', !details.assignedAssets.length);
                window.refreshAssetRequirementSections();
                window.refreshAssetRequirementSectionPackedTotals();
                refreshProjectAssetBulkSelection();
                applyProjectAssetFilters();
            }, false);
        }

