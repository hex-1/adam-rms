                    childRow.append($('<td>').append($('<span class="badge projectAssetPhysicalStatus">').text(statusName).css({backgroundColor: asset.statusColour, color: asset.statusTextColour})));
                    const assetMass = asset.assets_mass !== null ? parseFloat(asset.assets_mass) : parseFloat(asset.assetTypes_mass);
                    childRow.append($('<td>').text(assetMass > 0 ? assetMass.toFixed(2) + ' kg' : '?').attr('title', assetMass > 0 ? '' : 'No mass defined'));
                    const assetValue = asset.assets_value !== null ? parseInt(asset.assets_value, 10) : parseInt(asset.assetTypes_value, 10);
                    childRow.append($('<td>').text(assetValue > 0 ? new Intl.NumberFormat(undefined, {style: 'currency', currency: '{{ USERDATA.instance.instances_config_currency }}'}).format(assetValue / 100) : '?').attr('title', assetValue > 0 ? '' : 'No replacement value defined'));
                    childRow.append('<td></td><td></td><td></td>');
