                        asset.assetsAssignments_comment ? $('<span class="projectAssetPhysicalComment text-muted ml-2">').append('<i class="far fa-sticky-note mr-1"></i>', document.createTextNode(asset.assetsAssignments_comment)) : $('<span class="projectAssetPhysicalComment text-muted ml-2">')
                    ));
                    const assetContentCell = childRow.children('td').eq(1);
                    (asset.flagsblocks.BLOCK || []).forEach(function (warning) {
                        assetContentCell.append($('<a target="_blank" class="badge badge-danger ml-2"><i class="fas fa-ban"></i><span class="sr-only">Blocked</span></a>')
