            const target = highest.statuses[targetIndex];
            if (!target) return null;
            const targetName = String(target.assetsAssignmentsStatus_name || '').toLowerCase();
            let supportedByAll = true;
            selectedProjectAssetRows().each(function () {
                if (!statusListForProjectAssetRow($(this)).some(function (status) {
                    return String(status.assetsAssignmentsStatus_name || '').toLowerCase() === targetName;
                })) supportedByAll = false;
