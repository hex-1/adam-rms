                    if (locationText) detailsLine.append($('<span class="mr-2"><i class="fas fa-map-marker-alt mr-1"></i></span>').append(document.createTextNode(locationText)));
                    (asset.assetTypes_definableFields_ARRAY || []).forEach(function (field, index) {
