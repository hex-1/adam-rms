            if (mode === 'previous') return current > 0 ? statuses[current - 1] : null;
            if (mode === 'next') return current < statuses.length - 1 ? statuses[Math.max(0, current + 1)] : null;
            const name = mode === 'packed' ? 'packed' : String(chosenName || '').toLowerCase();
            const target = statuses.find(function (status) { return String(status.assetsAssignmentsStatus_name || '').toLowerCase() === name; });
            if (!target || (mode === 'packed' && current >= statuses.indexOf(target))) return null;
            return target;
