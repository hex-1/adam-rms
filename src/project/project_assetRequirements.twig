        function bulkTransitionForSelectedAssets(mode) {
            let highest = null;
            selectedProjectAssetRows().each(function () {
                const row = $(this);
                const statuses = statusListForProjectAssetRow(row);
                const current = statuses.findIndex(function (status) {
                    return parseInt(status.assetsAssignmentsStatus_id, 10) === parseInt(row.attr('data-status-id'), 10);
                });
                // The server normally resolves a NULL assignment to the first
                // configured state. Keeping -1 as a fallback also lets an old
                // fragment advance once if it was rendered before a refresh.
                if (statuses.length && (!highest || current > highest.index)) highest = {index: current, statuses: statuses};
            });
            if (!highest) return null;
