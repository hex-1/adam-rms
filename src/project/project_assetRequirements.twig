                const section = $('#projectAssetRequirementsTableBody > [data-kind="section"][data-id="' + sectionId + '"]');
                targetDepth = (parseInt(section.attr('data-depth'), 10) || 0) + 1;
                destination = section;
                let next = section.next();
                while (next.length && (parseInt(next.attr('data-depth'), 10) || 0) >= targetDepth) { destination = next; next = next.next(); }
            } else destination = $('#projectAssetRequirementsTableBody').children().last();
            rows.each(function () {
