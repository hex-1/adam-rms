                    insertAfter.after(childRow);
                    insertAfter = childRow;
                    const row = $('<div class="d-flex justify-content-between align-items-center border-bottom py-2">');
                    row.append($('<span>').text(asset.assets_tag + (asset.assetsAssignmentsStatus_name ? ' — ' + asset.assetsAssignmentsStatus_name : '')));
