<style>
    #projectAssetRequirementsCardBody { position: relative; }
    #projectAssetHierarchyBoxLayer {
        inset: 0;
        pointer-events: none;
        position: absolute;
        z-index: 0;
    }
    #projectAssetHierarchyBoxLayer .projectAssetHierarchyBox {
        background: rgba(255, 255, 255, .97);
        border: 1px solid rgba(108, 117, 125, .34);
        border-radius: .65rem;
        box-shadow: 0 .15rem .38rem rgba(33, 37, 41, .13);
        position: absolute;
    }
    #projectAssetRequirementsCardBody > :not(#projectAssetHierarchyBoxLayer) { position: relative; z-index: 1; }
    #projectAssetRequirementsTableBody > tr,
    #projectAssetRequirementsTableBody > tr > td { background-color: transparent !important; }
    #projectAssetRequirementsTableBody > tr > td { border-top-color: transparent !important; }
    @media print { #projectAssetHierarchyBoxLayer { display: none; } }
    #projectAssetRequirementActions .btn-tool {
        color: #212529 !important;
    }
    #projectAssetRequirementActions .btn-tool:hover,
    #projectAssetRequirementActions .btn-tool:focus {
        color: #212529 !important;
        font-weight: 700;
    }
    #projectAssetRequirementsTableBody .projectAssetHierarchyGutter {
        min-width: 4.25rem;
        white-space: nowrap;
    }
    #projectAssetRequirementsTableBody .projectAssetHierarchyGutter input,
    #projectAssetRequirementsTableBody .projectAssetDragHandle {
        display: inline-block;
        vertical-align: middle;
    }
</style>
<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">Planned Asset Requirements</h3>
        <div class="card-tools" id="projectAssetRequirementActions">
            <div class="btn-group mr-2" id="projectAssetBulkToolbar" style="display: none;">
                <button type="button" class="btn btn-tool dropdown-toggle" data-toggle="dropdown"><i class="fas fa-tasks mr-1"></i><span id="projectAssetBulkCount">0 selected</span></button>
                <div class="dropdown-menu dropdown-menu-right">
                    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
                    <button type="button" class="dropdown-item projectAssetBulkStatus" data-mode="previous"><i class="fas fa-arrow-left mr-2"></i><span>Previous status</span></button>
                    <button type="button" class="dropdown-item projectAssetBulkStatus" data-mode="next"><i class="fas fa-arrow-right mr-2"></i><span>Next status</span></button>
                    <button type="button" class="dropdown-item projectAssetBulkStatus" data-mode="packed"><i class="fas fa-box mr-2"></i>Jump to Packed</button>
                    <button type="button" class="dropdown-item projectAssetBulkRequirementPacked" data-packed="0"><i class="fas fa-box-open mr-2"></i>Clear planned packed override</button>
                    <button type="button" class="dropdown-item projectAssetBulkChooseStatus"><i class="fas fa-list mr-2"></i>Choose status…</button>
                    <div class="dropdown-divider"></div>
                    {% endif %}
                    {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMNET_COMMENT"|instancePermissions %}
                    <button type="button" class="dropdown-item projectAssetBulkNote"><i class="far fa-sticky-note mr-2"></i>Set note…</button>
                    {% endif %}
                    {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
                    <button type="button" class="dropdown-item projectAssetBulkEditRequirements"><i class="fas fa-edit mr-2"></i>Edit planned requirements…</button>
                    <button type="button" class="dropdown-item text-danger projectAssetBulkRemove"><i class="fas fa-unlink mr-2"></i>Remove from job</button>
                    <button type="button" class="dropdown-item text-danger projectAssetBulkDeleteRequirements"><i class="fas fa-trash mr-2"></i>Delete planned requirements</button>
                    {% endif %}
                    <div class="dropdown-divider"></div>
                    <button type="button" class="dropdown-item projectAssetBulkClear"><i class="far fa-square mr-2"></i>Clear selection</button>
                </div>
            </div>
            <span id="assetRequirementOrderStatus" class="text-muted mr-2" style="display: none;"></span>
            {% if project.projects_archived != 1 and "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
            <button type="button" class="btn btn-tool" title="Add Asset Requirement" data-toggle="modal" data-target="#addAssetRequirementModal"><i class="fas fa-list-ol"></i> Add Requirement</button>
            {% endif %}
            <button type="button" class="btn btn-tool" id="printProjectAssetRequirements" title="Print planned assets"><i class="fas fa-print"></i> Print</button>
            <button type="button" class="btn btn-tool" id="exportProjectAssetRequirements" title="Export planned assets as CSV"><i class="fas fa-file-csv"></i> Export</button>
            {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
            <button type="button" class="btn btn-tool" title="Add Section" data-toggle="modal" data-target="#addAssetRequirementSectionModal">
                <i class="fas fa-folder-plus"></i> Add Section
            </button>
            {% endif %}
            {% if (project.assetRequirements or FINANCIALS.assetsAssigned or FINANCIALS.assetsAssignedSUB) and "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMENT_STATUS"|instancePermissions %}
            <button type="button" class="btn btn-tool" title="Dispatch Assets" data-toggle="modal" data-target="#barcodeDispatchModal">
                <i class="fas fa-barcode"></i> Dispatch Assets
            </button>
            {% endif %}
        </div>
    </div>
    <div class="card-body p-0" id="projectAssetRequirementsCardBody">
        <div id="projectAssetHierarchyBoxLayer" aria-hidden="true"></div>
        <div class="d-flex flex-wrap align-items-center border-bottom px-3 py-2" id="projectAssetRequirementSummary">
            <span class="mr-4"><b>Packed:</b> <span id="projectAssetSummaryPacked">{{ project.assetRequirementSummary.packed }} / {{ project.assetRequirementSummary.required }}</span></span>
            <span class="mr-4"><b>Weight:</b> <span id="projectAssetSummaryMass">{{ project.assetRequirementSummary.mass|number_format(2) }} kg{% if project.assetRequirementSummary.unknownMass %} + ?{% endif %}</span></span>
            <span class="mr-4"><b>Replacement value:</b> <span id="projectAssetSummaryValue">{{ project.assetRequirementSummary.value|money }}{% if project.assetRequirementSummary.unknownValue %} + ?{% endif %}</span></span>
            <span class="mr-4"><b>Cost:</b> <span id="projectAssetSummaryPrice">{{ project.assetRequirementSummary.price|money }}</span></span>
            <span class="badge badge-danger mr-2{% if not project.assetRequirementSummary.blockedAssets %} d-none{% endif %}" id="projectAssetSummaryBlocks"><i class="fas fa-ban mr-1"></i>{{ project.assetRequirementSummary.blockedAssets }} blocked</span>
            <span class="badge badge-warning{% if not project.assetRequirementSummary.flaggedAssets %} d-none{% endif %}" id="projectAssetSummaryFlags"><i class="far fa-flag mr-1"></i>{{ project.assetRequirementSummary.flaggedAssets }} flagged</span>
            <span class="badge badge-danger ml-2{% if not project.assetRequirementSummary.shortages %} d-none{% endif %}" id="projectAssetSummaryShortages"><i class="fas fa-exclamation-triangle mr-1"></i>{{ project.assetRequirementSummary.shortages }} shortages</span>
        </div>
        <div class="form-row align-items-center border-bottom px-3 py-2">
            <div class="col-md-8"><div class="input-group input-group-sm"><div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-search"></i></span></div><input type="search" class="form-control" id="projectAssetRequirementSearch" placeholder="Search sections, Asset Types, tags, notes, locations or custom fields"></div></div>
            <div class="col-md-4"><select class="form-control form-control-sm" id="projectAssetRequirementFilter"><option value="all">All items</option><option value="shortage">Shortages only</option><option value="warnings">Flags and blocks</option><option value="unpacked">Not fully packed</option><option value="unknown-mass">Missing weight</option><option value="cross-instance">Other units</option></select></div>
        </div>
        <table class="table projects">
            <thead><tr><th style="width: 4.25rem;"><input type="checkbox" id="projectAssetBulkAll" title="Select all allocated assets" aria-label="Select all allocated assets"></th><th>Asset Type</th><th style="width: 11em;">Status</th><th>Weight</th><th>Value</th><th>Cost per unit</th><th>Discount</th><th>Total cost</th><th style="width: 3rem;"></th></tr></thead>
            <tbody id="projectAssetRequirementsTableBody">
                <tr id="projectAssetRequirementsEmpty" {% if project.assetRequirementOutline %}style="display: none;"{% endif %}>
                    <td colspan="9"><i>No Asset Type requirements have been added yet.</i></td>
                </tr>
                {% for item in project.assetRequirementOutline %}
                    {% if item.kind == 'section' %}
                    <tr class="projectAssetOutlineItem projectAssetRequirementSection" data-kind="section" data-id="{{ item.section.projectAssetRequirementSections_id }}" data-depth="{{ item.depth }}">
                        <td class="projectAssetHierarchyGutter text-left">
                            <input type="checkbox" class="projectAssetBulkSection mr-1" title="Select assets in this section" aria-label="Select assets in this section">
                            <span class="projectAssetDragHandle" title="Drag to reorder; move left or right to change indentation" style="display: inline-block; cursor: grab;"><i class="fas fa-bars text-muted"></i></span>
                        </td>
                        <td class="projectAssetOutlineContent{% if item.depth > 0 %} projectAssetNestedContent{% endif %}" style="--asset-guide-left: {{ 0.75 + ((item.depth - 1) * 1.25) }}rem; padding-left: {{ 0.75 + (item.depth * 1.25) }}rem;">
                            <button type="button" class="btn btn-link btn-sm p-0 mr-2 projectAssetSectionToggle text-muted" data-section-id="{{ item.section.projectAssetRequirementSections_id }}" aria-expanded="true" title="Collapse section">
                                <i class="fas fa-folder-open"></i><span class="sr-only">Toggle section</span>
                            </button>
                            <b>{{ item.section.projectAssetRequirementSections_name }}</b>
                            {% if item.section.assetCategoriesGroups_id %}<span class="badge badge-secondary ml-2">Automatic category</span>{% endif %}
                            <span class="projectAssetSectionWarnings ml-2">{% if item.blockedAssetCount %}<span class="badge badge-danger mr-1" title="{{ item.blockedAssetCount }} blocked asset(s)"><i class="fas fa-ban mr-1"></i>{{ item.blockedAssetCount }}</span>{% endif %}{% if item.flaggedAssetCount %}<span class="badge badge-warning" title="{{ item.flaggedAssetCount }} flagged asset(s)"><i class="far fa-flag mr-1"></i>{{ item.flaggedAssetCount }}</span>{% endif %}</span>
                        </td>
                        <td class="projectAssetSectionPacked">
                            <span class="badge {{ item.requiredCount > 0 and item.packedCount >= item.requiredCount ? 'badge-success' : 'badge-secondary' }} projectAssetStatusBadge" data-availability-status="{{ item.availability.status }}" title="{{ item.availability.label }}">{{ item.packedCount }} / {{ item.requiredCount }} packed</span>
                            <span class="badge ml-1 projectAssetAvailabilityBadge {{ item.availability.status == 'shortage' ? 'badge-danger' : (item.availability.status in ['turnaround', 'low-stock'] ? 'badge-warning' : (item.availability.status == 'available' ? 'badge-success' : 'badge-secondary')) }}" title="{{ item.availability.label }}">{{ item.availability.status == 'low-stock' ? 'Low stock' : (item.availability.status == 'turnaround' ? 'Turnaround' : item.availability.status|capitalize) }}</span>
                        </td>
                        <td class="projectAssetSectionTotalMass" title="{% if item.unknownMassCount %}{{ item.unknownMassCount }} item(s) have no mass defined{% endif %}">{{ item.totalMass|number_format(2) }} kg{% if item.unknownMassCount %} + ?{% endif %}</td>
                        <td class="projectAssetSectionTotalValue" title="{% if item.unknownValueCount %}{{ item.unknownValueCount }} item(s) have no replacement value defined{% endif %}">{{ item.totalValue|money }}{% if item.unknownValueCount %} + ?{% endif %}</td>
                        <td></td><td></td><td class="projectAssetSectionTotalPrice">{{ item.totalPrice|money }}</td>
                        <td>
                            {% if not item.section.isDirectAssignmentSection %}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" type="button" data-toggle="dropdown" aria-label="Section actions"><i class="fas fa-ellipsis-v"></i></button>
                                <div class="dropdown-menu dropdown-menu-right">
                                    {% if "PROJECTS:PROJECT_ASSETS:CREATE:ASSIGN_AND_UNASSIGN"|instancePermissions %}
                                    <button class="dropdown-item addRequirementToSection" type="button" data-section-id="{{ item.section.projectAssetRequirementSections_id }}"><i class="fas fa-plus mr-2"></i>Add item requirement</button>
                                    <div class="dropdown-divider"></div>
                                    {% endif %}
                                    <button class="dropdown-item text-danger deleteAssetRequirementSection" type="button" data-section-id="{{ item.section.projectAssetRequirementSections_id }}"><i class="fas fa-trash mr-2"></i>Delete section</button>
                                </div>
                            </div>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    {% set requirement = item.requirement %}
                    <tr id="projectAssetRequirement{{ requirement.projectAssetRequirements_id }}" class="projectAssetOutlineItem{% if requirement.isDirectAssignmentGroup %} projectAssetDirectGroup{% endif %}" data-kind="{{ requirement.isDirectAssignmentGroup ? 'direct' : 'requirement' }}" data-id="{{ requirement.projectAssetRequirements_id }}" data-depth="{{ item.depth }}" data-required="{{ requirement.projectAssetRequirements_quantity }}" data-note="{{ requirement.projectAssetRequirements_note|e('html_attr') }}" data-period-price="{{ requirement.periodPrice|moneyDecimal }}" data-discount="{{ requirement.projectAssetRequirements_discount }}" data-total-price="{{ requirement.totalPrice|moneyDecimal }}" data-total-mass="{{ requirement.totalMass }}" data-unknown-mass="{{ requirement.unknownMassCount }}" data-total-value="{{ requirement.totalValue }}" data-unknown-value="{{ requirement.unknownValueCount }}" data-warning-blocks="{{ requirement.blockedAssetCount }}" data-warning-flags="{{ requirement.flaggedAssetCount }}">
                        <td class="projectAssetHierarchyGutter text-left">
                            <input type="checkbox" class="projectAssetBulkRequirement mr-1" title="Select allocated assets of this type" aria-label="Select allocated assets of this type">
                            <span class="projectAssetDragHandle" title="Drag to reorder; move left or right to change indentation" style="display: inline-block; cursor: grab;"><i class="fas fa-bars text-muted"></i></span>
                        </td>
                        <td class="projectAssetOutlineContent{% if item.depth > 0 %} projectAssetNestedContent{% endif %}" style="--asset-guide-left: {{ 0.75 + ((item.depth - 1) * 1.25) }}rem; padding-left: {{ 0.75 + (item.depth * 1.25) }}rem;">
                            <button type="button" class="btn btn-link btn-sm p-0 mr-2 projectAssetRequirementToggle text-muted" data-requirement-id="{{ requirement.projectAssetRequirements_id }}" aria-expanded="true" title="Collapse allocated assets" {{ requirement.assignedAssets ? '' : 'disabled' }}>
                                <i class="fas fa-box-open"></i><span class="sr-only">Toggle allocated assets</span>
                            </button>
                            <a href="{{ CONFIG.ROOTURL }}/asset.php?id={{ requirement.assetTypes_id }}">
                                <b>{{ requirement.manufacturers_id != 1 ? requirement.manufacturers_name ~ ' - ' : '' }}{{ requirement.assetTypes_name }}</b>
                            </a>
                            {% if requirement.isDirectAssignmentGroup %}<span class="badge badge-info ml-2">Directly assigned</span>{% endif %}
                            <span class="projectAssetRequirementWarnings ml-2">{% if requirement.blockedAssetCount %}<span class="badge badge-danger mr-1" title="{{ requirement.blockedAssetCount }} blocked asset(s)"><i class="fas fa-ban mr-1"></i>{{ requirement.blockedAssetCount }}</span>{% endif %}{% if requirement.flaggedAssetCount %}<span class="badge badge-warning" title="{{ requirement.flaggedAssetCount }} flagged asset(s)"><i class="far fa-flag mr-1"></i>{{ requirement.flaggedAssetCount }}</span>{% endif %}</span>
                            <div class="projectAssetRequirementNote text-muted small{% if not requirement.projectAssetRequirements_note %} d-none{% endif %}"><i class="far fa-sticky-note mr-1"></i><span>{{ requirement.projectAssetRequirements_note }}</span></div>
                        </td>
                        <td class="projectAssetRequirementPacked">
                            <span class="badge {{ requirement.projectAssetRequirements_quantity > 0 and requirement.packedCount >= requirement.projectAssetRequirements_quantity ? 'badge-success' : 'badge-secondary' }} projectAssetStatusBadge" data-availability-status="{{ requirement.availability.status }}" title="{{ requirement.availability.label }}">{{ requirement.packedCount }} / {{ requirement.projectAssetRequirements_quantity }} packed</span>
                            <span class="badge ml-1 projectAssetAvailabilityBadge {{ requirement.availability.status == 'shortage' ? 'badge-danger' : (requirement.availability.status in ['turnaround', 'low-stock'] ? 'badge-warning' : (requirement.availability.status == 'available' ? 'badge-success' : 'badge-secondary')) }}" title="{{ requirement.availability.label }}">{{ requirement.availability.status == 'low-stock' ? 'Low stock' : (requirement.availability.status == 'turnaround' ? 'Turnaround' : requirement.availability.status|capitalize) }}</span>
                        </td>
                        <td class="projectAssetRequirementTotalMass" title="{% if requirement.unknownMassCount %}{{ requirement.unknownMassCount }} item(s) have no mass defined{% endif %}">{{ requirement.totalMass|number_format(2) }} kg{% if requirement.unknownMassCount %} + ?{% endif %}</td>
                        <td class="projectAssetRequirementTotalValue" title="{% if requirement.unknownValueCount %}{{ requirement.unknownValueCount }} item(s) have no replacement value defined{% endif %}">{{ requirement.totalValue|money }}{% if requirement.unknownValueCount %} + ?{% endif %}</td>
                        <td class="projectAssetRequirementUnitPrice{% if not requirement.isDirectAssignmentGroup %} projectAssetRequirementPriceEditable{% endif %}"{% if not requirement.isDirectAssignmentGroup %} title="Click to edit cost per unit" style="cursor: pointer;"{% endif %}>{{ requirement.isDirectAssignmentGroup ? '—' : requirement.periodPrice|money }}</td>
                        <td class="projectAssetRequirementDiscount{% if not requirement.isDirectAssignmentGroup %} projectAssetRequirementPriceEditable{% endif %}"{% if not requirement.isDirectAssignmentGroup %} title="Click to edit discount" style="cursor: pointer;"{% endif %}>{{ requirement.isDirectAssignmentGroup ? '—' : requirement.projectAssetRequirements_discount|number_format(2) ~ '%' }}</td>
                        <td class="projectAssetRequirementTotalPrice">{{ requirement.totalPrice|money }}</td>
                        <td>
                            {% if not requirement.isDirectAssignmentGroup %}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" type="button" data-toggle="dropdown" aria-label="Planned asset actions"><i class="fas fa-ellipsis-v"></i></button>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <button class="dropdown-item editAssetRequirement" type="button" data-requirement-id="{{ requirement.projectAssetRequirements_id }}"><i class="fas fa-edit mr-2"></i>Edit</button>
                                    <div class="dropdown-divider"></div>
                                    <button class="dropdown-item text-danger deleteAssetRequirement" type="button" data-requirement-id="{{ requirement.projectAssetRequirements_id }}"><i class="fas fa-trash mr-2"></i>Delete</button>
                                </div>
                            </div>
                            {% endif %}
                        </td>
                    </tr>
                    {% for assignedAsset in requirement.assignedAssets %}
                    <tr class="projectAssetPhysicalAsset" data-kind="asset" data-requirement-id="{{ requirement.projectAssetRequirements_id }}" data-assignment-id="{{ assignedAsset.assetsAssignments_id }}" data-instance-id="{{ assignedAsset.instances_id }}" data-status-id="{{ assignedAsset.assetsAssignmentsStatus_id }}" data-asset-tag="{{ assignedAsset.assets_tag|e('html_attr') }}" data-comment="{{ assignedAsset.assetsAssignments_comment|e('html_attr') }}" data-linked="{{ assignedAsset.isLinkedAsset ? '1' : '0' }}" data-can-remove="{{ assignedAsset.canRemove ? '1' : '0' }}" data-linked-depth="{{ assignedAsset.linkedDepth }}" data-depth="{{ item.depth + 1 + assignedAsset.linkedDepth }}" data-cross-instance="{{ assignedAsset.sourceInstanceName ? '1' : '0' }}">
                        <td><input type="checkbox" class="projectAssetBulkAsset" aria-label="Select {{ assignedAsset.assets_tag|e('html_attr') }}"></td>
                        <td class="projectAssetNestedContent" style="--asset-guide-left: {{ 0.75 + ((item.depth + assignedAsset.linkedDepth) * 1.25) }}rem; padding-left: {{ 0.75 + ((item.depth + 1 + assignedAsset.linkedDepth) * 1.25) }}rem;">
                            <i class="fas {{ assignedAsset.isLinkedAsset ? 'fa-link' : 'fa-tag' }} text-muted mr-2"{% if assignedAsset.isLinkedAsset %} title="Linked accessory"{% endif %}></i>
                            <a href="{{ CONFIG.ROOTURL }}/asset.php?id={{ assignedAsset.assetTypes_id }}&asset={{ assignedAsset.assets_id }}&instance={{ assignedAsset.instances_id }}">
                                {{ assignedAsset.assets_tag|aTag }}
                            </a>
                            {% if assignedAsset.isLinkedAsset %}<span class="text-muted ml-2">{{ assignedAsset.assetTypes_name }}</span>{% endif %}
                            {% for warning in assignedAsset.flagsblocks.BLOCK %}<a target="_blank" href="{{ CONFIG.ROOTURL }}/maintenance/job.php?id={{ warning.maintenanceJobs_id }}" class="badge badge-danger ml-2" title="Blocked: {{ warning.maintenanceJobs_title|e('html_attr') }}"><i class="fas fa-ban"></i><span class="sr-only">Blocked</span></a>{% endfor %}
                            {% for warning in assignedAsset.flagsblocks.FLAG %}<a target="_blank" href="{{ CONFIG.ROOTURL }}/maintenance/job.php?id={{ warning.maintenanceJobs_id }}" class="badge badge-warning ml-2" title="Flagged: {{ warning.maintenanceJobs_title|e('html_attr') }}"><i class="far fa-flag"></i><span class="sr-only">Flagged</span></a>{% endfor %}
                            <span class="projectAssetPhysicalComment text-muted ml-2">{% if assignedAsset.assetsAssignments_comment %}<i class="far fa-sticky-note mr-1"></i>{{ assignedAsset.assetsAssignments_comment }}{% endif %}</span>
                            <div class="small text-muted projectAssetPhysicalDetails">
                                {% if assignedAsset.sourceInstanceName %}<span class="badge badge-info mr-2" title="Owned by another unit"><i class="fas fa-building mr-1"></i>{{ assignedAsset.sourceInstanceName }}</span>{% endif %}
                                {% if assignedAsset.latestScan.locations_name %}<span class="mr-2"><i class="fas fa-map-marker-alt mr-1"></i>{{ assignedAsset.latestScan.locations_name }}</span>{% elseif assignedAsset.latestScan.assetTypes_name %}<span class="mr-2"><i class="fas fa-box mr-1"></i>Inside {{ assignedAsset.latestScan.assetTypes_name }}</span>{% elseif assignedAsset.latestScan.assetsBarcodes_customLocation %}<span class="mr-2"><i class="fas fa-map-marker-alt mr-1"></i>{{ assignedAsset.latestScan.assetsBarcodes_customLocation }}</span>{% elseif assignedAsset.assets_storageLocation %}<span class="mr-2"><i class="fas fa-warehouse mr-1"></i>{{ assignedAsset.assets_storageLocation }}</span>{% endif %}
                                {% for field in assignedAsset.assetTypes_definableFields_ARRAY %}{% set fieldValue = attribute(assignedAsset, 'asset_definableFields_' ~ loop.index) %}{% if fieldValue %}<span class="badge badge-light mr-1"><b>{{ field }}:</b> {{ fieldValue }}</span>{% endif %}{% endfor %}
                            </div>
                        </td>
                        <td><span class="badge projectAssetPhysicalStatus" style="background-color: {{ assignedAsset.statusColour }}; color: {{ assignedAsset.statusTextColour }};">{{ assignedAsset.displayStatus }}</span></td>
                        {% set assignedAssetMass = assignedAsset.assets_mass is not null ? assignedAsset.assets_mass : assignedAsset.assetTypes_mass %}
                        <td title="{{ assignedAssetMass is null or assignedAssetMass <= 0 ? 'No mass defined' : '' }}">{{ assignedAssetMass is not null and assignedAssetMass > 0 ? assignedAssetMass|number_format(2) ~ ' kg' : '?' }}</td>
                        {% set assignedAssetValue = assignedAsset.assets_value is not null ? assignedAsset.assets_value : assignedAsset.assetTypes_value %}
                        <td title="{{ assignedAssetValue is null or assignedAssetValue <= 0 ? 'No replacement value defined' : '' }}">{{ assignedAssetValue is not null and assignedAssetValue > 0 ? assignedAssetValue|money : '?' }}</td>
                        <td></td><td></td><td></td><td class="projectAssetPhysicalActions"></td>
                    </tr>
                    {% endfor %}
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="bulkEditAssetRequirementsModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h4 class="modal-title">Edit selected planned requirements</h4><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div>
        <div class="modal-body">
            <p class="text-muted"><span id="bulkEditAssetRequirementCount">0</span> planned requirements selected. Only enabled adjustments will be applied.</p>
            <div class="form-group"><label>Quantity</label><div class="form-row"><div class="col-7"><select class="form-control" id="bulkRequirementQuantityMode"><option value="unchanged">No change</option><option value="set">Set each quantity to</option><option value="add">Add to each quantity</option><option value="subtract">Subtract from each quantity</option></select></div><div class="col-5"><input class="form-control" id="bulkRequirementQuantityValue" type="number" min="1" step="1" value="1" disabled></div></div></div>
            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMNET_COMMENT"|instancePermissions %}<div class="form-group"><div class="custom-control custom-checkbox"><input class="custom-control-input" type="checkbox" id="bulkRequirementSetNote"><label class="custom-control-label" for="bulkRequirementSetNote">Set note</label></div><textarea class="form-control mt-2" id="bulkRequirementNote" rows="3" disabled></textarea></div>{% endif %}
            {% if project.projectsTypes_config_finance == 1 %}<div class="form-row">
                {% if "PROJECTS:PROJECT_ASSETS:EDIT:CUSTOM_PRICE"|instancePermissions %}<div class="form-group col-6"><div class="custom-control custom-checkbox"><input class="custom-control-input" type="checkbox" id="bulkRequirementSetPrice"><label class="custom-control-label" for="bulkRequirementSetPrice">Set period cost</label></div><input class="form-control mt-2" id="bulkRequirementPrice" inputmode="decimal" disabled placeholder="Blank = default rate"></div>{% endif %}
                {% if "PROJECTS:PROJECT_ASSETS:EDIT:DISCOUNT"|instancePermissions %}<div class="form-group col-6"><div class="custom-control custom-checkbox"><input class="custom-control-input" type="checkbox" id="bulkRequirementSetDiscount"><label class="custom-control-label" for="bulkRequirementSetDiscount">Set discount</label></div><input class="form-control mt-2" id="bulkRequirementDiscount" type="number" min="0" max="100" step="0.01" value="0" disabled></div>{% endif %}
            </div>{% endif %}
            <div class="form-group"><div class="custom-control custom-checkbox"><input class="custom-control-input" type="checkbox" id="bulkRequirementMoveSection"><label class="custom-control-label" for="bulkRequirementMoveSection">Move to section</label></div><select class="form-control mt-2" id="bulkRequirementSection" disabled><option value="">Top level</option>{% for section in project.assetRequirementSectionOptions %}<option value="{{ section.id }}">{{ section.path }}</option>{% endfor %}</select></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="saveBulkAssetRequirements">Apply changes</button></div>
    </div></div>
</div>
<div class="modal fade" id="editProjectPhysicalAssetModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Edit allocated asset</h4>
            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editProjectPhysicalAssignmentId">
            <input type="hidden" id="editProjectPhysicalRequirementId">
            <div class="form-group">
                <label>Current asset</label>
                <p id="editProjectPhysicalCurrentAsset" class="form-control-plaintext mb-0"></p>
            </div>
            <div class="form-group">
                <label for="editProjectPhysicalComment">Note</label>
                <textarea class="form-control" id="editProjectPhysicalComment" rows="3"{% if not "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMNET_COMMENT"|instancePermissions %} readonly{% endif %}></textarea>
            </div>
            <div id="editProjectPhysicalLocked" class="alert alert-warning" style="display: none;">Packed assets, and assets beyond Packed, cannot be replaced.</div>
            <div class="form-group" id="editProjectPhysicalReplacementGroup">
                <label for="editProjectPhysicalReplacement">Replace allocated asset with</label>
                <select class="form-control" id="editProjectPhysicalReplacement"></select>
                <small class="form-text text-muted">Only available physical assets of the same Asset Type are shown.</small>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="saveProjectPhysicalAsset">Save changes</button>
        </div>
    </div></div>
</div>
<div class="modal fade" id="editAssetRequirementModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Edit Planned Asset</h4>
            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editAssetRequirementId">
            <div class="form-group">
                <label for="editAssetRequirementQuantity">Quantity required</label>
                <input class="form-control" id="editAssetRequirementQuantity" type="number" min="1" step="1" required>
            </div>
            <div class="form-group">
                <label for="editAssetRequirementNote">Note</label>
                <textarea class="form-control" id="editAssetRequirementNote" rows="3" placeholder="For example: address fixtures as Stage A 1–8, or pre-wire speakers before loading."{% if not "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMNET_COMMENT"|instancePermissions %} readonly{% endif %}></textarea>
                <small class="form-text text-muted">This applies to the planned Asset Type and is available before physical assets are allocated.</small>
            </div>
            {% if project.projectsTypes_config_finance == 1 and "PROJECTS:PROJECT_ASSETS:EDIT:CUSTOM_PRICE"|instancePermissions and "PROJECTS:PROJECT_ASSETS:EDIT:DISCOUNT"|instancePermissions %}
            <div class="form-row">
                <div class="form-group col-md-6"><label for="editAssetRequirementPeriodPrice">Cost per unit for period</label><input class="form-control" id="editAssetRequirementPeriodPrice" inputmode="decimal"><small class="form-text text-muted">Leave blank to use the Asset Type’s calculated period rate.</small></div>
                <div class="form-group col-md-6"><label for="editAssetRequirementDiscount">Discount (%)</label><input class="form-control" id="editAssetRequirementDiscount" type="number" min="0" max="100" step="0.01"></div>
            </div>
            {% endif %}
            <hr>
            <h6>Allocated physical assets</h6>
            <div id="editAssetRequirementAssignments" class="mb-3"></div>
            <label for="editAssetRequirementScan">Add a physical asset</label>
            <div class="input-group">
                <input class="form-control" id="editAssetRequirementScan" placeholder="Asset tag or barcode" autocomplete="off">
                <div class="input-group-append"><button class="btn btn-outline-primary" id="editAssetRequirementAddAsset" type="button">Add</button></div>
            </div>
            <small class="form-text text-muted">Only physical assets matching this Asset Type can be allocated here.</small>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="saveAssetRequirementEdit">Save changes</button>
        </div>
    </div></div>
</div>
<script>
    $(function () {
        $('#editAssetRequirementModal').appendTo(document.body);
        $('#editProjectPhysicalAssetModal').appendTo(document.body);
        $('#bulkEditAssetRequirementsModal').appendTo(document.body);
        const collapsedStorageKey = 'collapsedAssetRequirementSections-{{ project.projects_id }}';
        let collapsedSectionIds = [];
        let collapsedRequirementIds = [];
        try {
            collapsedSectionIds = JSON.parse(sessionStorage.getItem(collapsedStorageKey) || '[]').map(Number);
        } catch (error) {
            collapsedSectionIds = [];
        }
        try {
            collapsedRequirementIds = JSON.parse(sessionStorage.getItem('collapsedAssetRequirements-{{ project.projects_id }}') || '[]').map(Number);
        } catch (error) {
            collapsedRequirementIds = [];
        }

        // Table rows cannot contain nested block elements, so group outlines
        // live in a pointer-events-free layer over the table. Their dimensions
        // are recalculated whenever rows move, collapse or are filtered.
        let hierarchyBoxFrame = null;
        window.refreshProjectAssetHierarchyBoxes = function () {
            if (hierarchyBoxFrame !== null) cancelAnimationFrame(hierarchyBoxFrame);
            hierarchyBoxFrame = requestAnimationFrame(function () {
                hierarchyBoxFrame = null;
                const container = $('#projectAssetRequirementsCardBody');
                const layer = $('#projectAssetHierarchyBoxLayer').empty();
                const containerOffset = container.offset();
                const visibleRows = $('#projectAssetRequirementsTableBody > tr[data-depth]:visible');
                visibleRows.each(function (index) {
                    const parent = $(this);
                    const depth = parseInt(parent.attr('data-depth'), 10) || 0;
                    const allNext = parent.next('tr[data-depth]');
                    const hasChildren = allNext.length && (parseInt(allNext.attr('data-depth'), 10) || 0) > depth;
                    let last = parent;
                    if (hasChildren) {
                        for (let nextIndex = index + 1; nextIndex < visibleRows.length; nextIndex++) {
                            const candidate = $(visibleRows[nextIndex]);
                            if ((parseInt(candidate.attr('data-depth'), 10) || 0) <= depth) break;
                            last = candidate;
                        }
                    }
                    const topInset = 3 + (depth * 2);
                    const bottomInset = 3 + (depth * 4);
                    const top = parent.offset().top - containerOffset.top + topInset;
                    const bottom = last.offset().top - containerOffset.top + last.outerHeight() - bottomInset;
                    const left = 6 + (depth * 5);
                    const right = 6 + (depth * 7);
                    const grey = Math.max(232, 249 - (depth * 5));
                    layer.append($('<div class="projectAssetHierarchyBox">').css({
                        top: top + 'px',
                        left: left + 'px',
                        right: right + 'px',
                        height: Math.max(12, bottom - top) + 'px',
                        backgroundColor: 'rgb(' + grey + ', ' + grey + ', ' + grey + ')',
                        boxShadow: '0 ' + Math.min(4, 2 + depth) + 'px ' + Math.min(8, 5 + depth) + 'px rgba(33, 37, 41, ' + Math.min(.15, .08 + (depth * .015)) + ')'
                    }));
                });
            });
        };

        // Collapse state lives in sessionStorage rather than the database. It is
        // a personal view preference and should not rearrange the job for other
        // planners. Filtering is applied last so hidden search results stay hidden.
        window.refreshAssetRequirementSections = function () {
            const collapsedAncestors = [];
            $('#projectAssetRequirementsTableBody > tr[data-depth]').each(function () {
                const row = $(this);
                const depth = parseInt(row.attr('data-depth'), 10) || 0;
                while (collapsedAncestors.length && collapsedAncestors[collapsedAncestors.length - 1] >= depth) {
                    collapsedAncestors.pop();
                }
                const requirementId = parseInt(row.data('requirement-id'), 10);
                const hiddenByRequirement = row.data('kind') === 'asset' && collapsedRequirementIds.indexOf(requirementId) !== -1;
                row.toggle(collapsedAncestors.length === 0 && !hiddenByRequirement && !row.hasClass('projectAssetFilterHidden'));
                if (row.data('kind') === 'section') {
                    const sectionId = parseInt(row.data('id'), 10);
                    const isCollapsed = collapsedSectionIds.indexOf(sectionId) !== -1;
                    const toggle = row.find('.projectAssetSectionToggle');
                    toggle.attr('aria-expanded', isCollapsed ? 'false' : 'true')
                        .attr('title', isCollapsed ? 'Expand section' : 'Collapse section');
                    toggle.find('i').toggleClass('fa-folder-open', !isCollapsed).toggleClass('fa-folder', isCollapsed);
                    if (isCollapsed) collapsedAncestors.push(depth);
                } else if (row.data('kind') === 'requirement' || row.data('kind') === 'direct') {
                    const isCollapsed = collapsedRequirementIds.indexOf(parseInt(row.data('id'), 10)) !== -1;
                    row.find('.projectAssetRequirementToggle').attr('aria-expanded', isCollapsed ? 'false' : 'true')
                        .attr('title', isCollapsed ? 'Expand allocated assets' : 'Collapse allocated assets')
                        .find('i').toggleClass('fa-box-open', !isCollapsed).toggleClass('fa-box', isCollapsed);
                }
            });
            window.refreshProjectAssetHierarchyBoxes();
        };
        $(window).on('resize', window.refreshProjectAssetHierarchyBoxes);
        // The assets list starts inside a hidden Bootstrap tab. Its rows have no
        // measurable layout until the tab is shown, so draw the hierarchy then
        // as well as during the normal initial refreshes and window resizes.
        $('#nav-bar a[href="#assets-view"]').on('shown.bs.tab', function () {
            window.refreshProjectAssetHierarchyBoxes();
        });
        // Parent rows show affected asset counts; the clickable maintenance-job
        // links remain on the physical rows where the warning originates.
        function renderProjectAssetWarningSummary(container, blocked, flagged) {
            container.empty();
            if (blocked) container.append($('<span class="badge badge-danger mr-1">').attr('title', blocked + ' blocked asset(s)').append('<i class="fas fa-ban mr-1"></i>', document.createTextNode(blocked)));
            if (flagged) container.append($('<span class="badge badge-warning">').attr('title', flagged + ' flagged asset(s)').append('<i class="far fa-flag mr-1"></i>', document.createTextNode(flagged)));
        }
        function updateProjectAssetAvailabilityBadge(badge, status, label) {
            const names = {'low-stock': 'Low stock', 'turnaround': 'Turnaround', 'shortage': 'Shortage', 'available': 'Available', 'unknown': 'Unknown'};
            badge.text(names[status] || status).attr('title', label || '')
                .toggleClass('badge-danger', status === 'shortage')
                .toggleClass('badge-warning', status === 'turnaround' || status === 'low-stock')
                .toggleClass('badge-success', status === 'available')
                .toggleClass('badge-secondary', status === 'unknown');
        }
        // Recalculate from requirement rows already in the DOM. Most edits are
        // background requests, so this avoids a full page load after every scan,
        // price change, drag or status update.
        window.refreshAssetRequirementSectionPackedTotals = function () {
            const severity = {'available': 0, 'unknown': 1, 'low-stock': 2, 'turnaround': 3, 'shortage': 4};
            // Direct-assignment groups are display-only, so derive their packed
            // count from the physical rows instead of the requirements API.
            $('#projectAssetRequirementsTableBody > [data-kind="direct"]').each(function () {
                const group = $(this);
                let packed = 0;
                const assets = $('#projectAssetRequirementsTableBody > .projectAssetPhysicalAsset[data-requirement-id="' + group.attr('data-id') + '"][data-linked="0"]');
                assets.each(function () {
                    const asset = $(this);
                    const statuses = statusListForProjectAssetRow(asset);
                    const current = statuses.findIndex(function (status) { return parseInt(status.assetsAssignmentsStatus_id, 10) === parseInt(asset.attr('data-status-id'), 10); });
                    const packedIndex = statuses.findIndex(function (status) { return String(status.assetsAssignmentsStatus_name || '').toLowerCase() === 'packed'; });
                    if (packedIndex !== -1 && current >= packedIndex) packed++;
                });
                const required = assets.length;
                group.attr('data-required', required).find('.projectAssetStatusBadge').text(packed + ' / ' + required + ' packed')
                    .toggleClass('badge-success', required > 0 && packed >= required).toggleClass('badge-secondary', required === 0 || packed < required);
            });
            // Each section owns every deeper row until the outline returns to its
            // depth. This naturally includes nested subsections in parent totals.
            $('#projectAssetRequirementsTableBody > [data-kind="section"]').each(function () {
                const sectionRow = $(this);
                const sectionDepth = parseInt(sectionRow.attr('data-depth'), 10) || 0;
                let packed = 0;
                let required = 0;
                let totalPrice = 0;
                let totalMass = 0;
                let unknownMass = 0;
                let totalValue = 0;
                let unknownValue = 0;
                let blockedAssets = 0;
                let flaggedAssets = 0;
                let worstBadge = null;
                let worstSeverity = -1;
                let row = sectionRow.next();
                while (row.length && (parseInt(row.attr('data-depth'), 10) || 0) > sectionDepth) {
                    if (row.data('kind') === 'requirement') {
                        packed += parseInt(row.find('.projectAssetRequirementPacked').text(), 10) || 0;
                        required += parseInt(row.attr('data-required'), 10) || 0;
                        totalPrice += parseFloat(row.attr('data-total-price')) || 0;
                        totalMass += parseFloat(row.attr('data-total-mass')) || 0;
                        unknownMass += parseInt(row.attr('data-unknown-mass'), 10) || 0;
                        totalValue += parseInt(row.attr('data-total-value'), 10) || 0;
                        unknownValue += parseInt(row.attr('data-unknown-value'), 10) || 0;
                        blockedAssets += parseInt(row.attr('data-warning-blocks'), 10) || 0;
                        flaggedAssets += parseInt(row.attr('data-warning-flags'), 10) || 0;
                        const requirementBadge = row.find('.projectAssetStatusBadge');
                        const requirementSeverity = severity[requirementBadge.data('availability-status')] ?? 0;
                        if (requirementSeverity > worstSeverity) {
                            worstSeverity = requirementSeverity;
                            worstBadge = requirementBadge;
                        }
                    }
                    row = row.next();
                }
                const sectionBadge = sectionRow.find('.projectAssetStatusBadge');
                sectionBadge.text(packed + ' / ' + required + ' packed');
                sectionBadge.toggleClass('badge-success', required > 0 && packed >= required)
                    .toggleClass('badge-secondary', required === 0 || packed < required);
                sectionRow.find('.projectAssetSectionTotalPrice').text(new Intl.NumberFormat(undefined, {style: 'currency', currency: '{{ USERDATA.instance.instances_config_currency }}'}).format(totalPrice));
                sectionRow.find('.projectAssetSectionTotalMass')
                    .text(totalMass.toFixed(2) + ' kg' + (unknownMass ? ' + ?' : ''))
                    .attr('title', unknownMass ? unknownMass + ' item(s) have no mass defined' : '');
                sectionRow.find('.projectAssetSectionTotalValue')
                    .text(new Intl.NumberFormat(undefined, {style: 'currency', currency: '{{ USERDATA.instance.instances_config_currency }}'}).format(totalValue / 100) + (unknownValue ? ' + ?' : ''))
                    .attr('title', unknownValue ? unknownValue + ' item(s) have no replacement value defined' : '');
                renderProjectAssetWarningSummary(sectionRow.find('.projectAssetSectionWarnings'), blockedAssets, flaggedAssets);
                if (worstBadge) {
                    const status = worstBadge.data('availability-status');
                    sectionBadge.attr('data-availability-status', status)
                        .attr('title', worstBadge.attr('title'));
                    updateProjectAssetAvailabilityBadge(sectionRow.find('.projectAssetAvailabilityBadge'), status, worstBadge.attr('title'));
                }
            });
            // The project summary counts requirement rows only. Section rows are
            // roll-ups of the same data and would otherwise double-count it.
            let summaryPacked = 0, summaryRequired = 0, summaryMass = 0, summaryUnknownMass = 0, summaryValue = 0, summaryUnknownValue = 0, summaryPrice = 0, summaryBlocks = 0, summaryFlags = 0, summaryShortages = 0;
            $('#projectAssetRequirementsTableBody > [data-kind="requirement"], #projectAssetRequirementsTableBody > [data-kind="direct"]').each(function () {
                const row = $(this);
                summaryPacked += parseInt(row.find('.projectAssetRequirementPacked').text(), 10) || 0;
                summaryRequired += parseInt(row.attr('data-required'), 10) || 0;
                summaryMass += parseFloat(row.attr('data-total-mass')) || 0;
                summaryUnknownMass += parseInt(row.attr('data-unknown-mass'), 10) || 0;
                summaryValue += parseInt(row.attr('data-total-value'), 10) || 0;
                summaryUnknownValue += parseInt(row.attr('data-unknown-value'), 10) || 0;
                summaryPrice += parseFloat(row.attr('data-total-price')) || 0;
                summaryBlocks += parseInt(row.attr('data-warning-blocks'), 10) || 0;
                summaryFlags += parseInt(row.attr('data-warning-flags'), 10) || 0;
                if (row.find('.projectAssetStatusBadge').attr('data-availability-status') === 'shortage') summaryShortages++;
            });
            const summaryMoney = new Intl.NumberFormat(undefined, {style: 'currency', currency: '{{ USERDATA.instance.instances_config_currency }}'});
            $('#projectAssetSummaryPacked').text(summaryPacked + ' / ' + summaryRequired);
            $('#projectAssetSummaryMass').text(summaryMass.toFixed(2) + ' kg' + (summaryUnknownMass ? ' + ?' : ''));
            $('#projectAssetSummaryValue').text(summaryMoney.format(summaryValue / 100) + (summaryUnknownValue ? ' + ?' : ''));
            $('#projectAssetSummaryPrice').text(summaryMoney.format(summaryPrice));
            $('#projectAssetSummaryBlocks').toggleClass('d-none', !summaryBlocks).html('<i class="fas fa-ban mr-1"></i>' + summaryBlocks + ' blocked');
            $('#projectAssetSummaryFlags').toggleClass('d-none', !summaryFlags).html('<i class="far fa-flag mr-1"></i>' + summaryFlags + ' flagged');
            $('#projectAssetSummaryShortages').toggleClass('d-none', !summaryShortages).html('<i class="fas fa-exclamation-triangle mr-1"></i>' + summaryShortages + ' shortages');
            window.refreshProjectAssetHierarchyBoxes();
        };
        // Several API calls may finish together during bulk actions. Queue one
        // follow-up refresh rather than dropping it or starting parallel refreshes.
        let requirementStatusRefreshInProgress = false;
        let requirementStatusRefreshPending = false;
        window.refreshProjectAssetRequirementStatuses = function () {
            if (requirementStatusRefreshInProgress) {
                requirementStatusRefreshPending = true;
                return;
            }
            requirementStatusRefreshInProgress = true;
            $.ajax({
                url: '{{ CONFIG.ROOTURL }}/api/projects/assets/refreshRequirementStatuses.php',
                type: 'POST',
                data: {projects_id: '{{ project.projects_id }}'},
                cache: false
            }).done(function (result) {
                if (!result.result) return;
                result.response.requirements.forEach(function (requirement) {
                    const row = $('#projectAssetRequirement' + requirement.id);
                    const badge = row.find('.projectAssetStatusBadge');
                    row.attr('data-required', requirement.required);
                    badge.text(requirement.packed + ' / ' + requirement.required + ' packed')
                        .attr('title', requirement.availability.label)
                        .attr('data-availability-status', requirement.availability.status)
                        .data('availability-status', requirement.availability.status)
                        .toggleClass('badge-success', requirement.required > 0 && requirement.packed >= requirement.required)
                        .toggleClass('badge-secondary', requirement.required === 0 || requirement.packed < requirement.required);
                    updateProjectAssetAvailabilityBadge(row.find('.projectAssetAvailabilityBadge'), requirement.availability.status, requirement.availability.label);
                });
                window.refreshAssetRequirementSectionPackedTotals();
            }).always(function () {
                requirementStatusRefreshInProgress = false;
                if (requirementStatusRefreshPending) {
                    requirementStatusRefreshPending = false;
                    window.refreshProjectAssetRequirementStatuses();
                }
            });
        };

        let requirementStatusRefreshTimer = null;
        $(document).ajaxComplete(function (event, xhr, settings) {
            if (settings.url.indexOf('/api/projects/') === -1 || settings.url.indexOf('refreshRequirementStatuses.php') !== -1) return;
            clearTimeout(requirementStatusRefreshTimer);
            requirementStatusRefreshTimer = setTimeout(window.refreshProjectAssetRequirementStatuses, 150);
        });
        $(window).on('focus', window.refreshProjectAssetRequirementStatuses);

        $('#projectAssetRequirementsTableBody').on('click', '.projectAssetSectionToggle', function () {
            const sectionId = parseInt($(this).data('section-id'), 10);
            const existingIndex = collapsedSectionIds.indexOf(sectionId);
            if (existingIndex === -1) collapsedSectionIds.push(sectionId);
            else collapsedSectionIds.splice(existingIndex, 1);
            sessionStorage.setItem(collapsedStorageKey, JSON.stringify(collapsedSectionIds));
            window.refreshAssetRequirementSections();
        });
        $('#projectAssetRequirementsTableBody').on('click', '.projectAssetRequirementToggle', function () {
            const requirementId = parseInt($(this).data('requirement-id'), 10);
            const existingIndex = collapsedRequirementIds.indexOf(requirementId);
            if (existingIndex === -1) collapsedRequirementIds.push(requirementId);
            else collapsedRequirementIds.splice(existingIndex, 1);
            sessionStorage.setItem('collapsedAssetRequirements-{{ project.projects_id }}', JSON.stringify(collapsedRequirementIds));
            window.refreshAssetRequirementSections();
        });

        window.refreshAssetRequirementSections();

        // Filters are evaluated at the lowest useful row. applyProjectAssetFilters
        // then restores matching parents so results retain their hierarchy.
        function projectAssetRowMatchesFilter(row, filter) {
            if (filter === 'all') return true;
            if (row.attr('data-kind') === 'requirement' || row.attr('data-kind') === 'direct') {
                if (filter === 'shortage') return row.find('.projectAssetStatusBadge').attr('data-availability-status') === 'shortage';
                if (filter === 'warnings') return (parseInt(row.attr('data-warning-blocks'), 10) || 0) > 0 || (parseInt(row.attr('data-warning-flags'), 10) || 0) > 0;
                if (filter === 'unpacked') return (parseInt(row.find('.projectAssetRequirementPacked').text(), 10) || 0) < (parseInt(row.attr('data-required'), 10) || 0);
                if (filter === 'unknown-mass') return (parseInt(row.attr('data-unknown-mass'), 10) || 0) > 0;
                if (filter === 'cross-instance') return $('#projectAssetRequirementsTableBody > .projectAssetPhysicalAsset[data-requirement-id="' + row.attr('data-id') + '"][data-cross-instance="1"]').length > 0;
            }
            if (row.attr('data-kind') === 'asset') {
                const parent = $('#projectAssetRequirement' + row.attr('data-requirement-id'));
                if (filter === 'shortage') return parent.find('.projectAssetStatusBadge').attr('data-availability-status') === 'shortage';
                if (filter === 'warnings') return row.find('.badge-danger, .badge-warning').length > 0;
                if (filter === 'unpacked') return String(row.find('.projectAssetPhysicalStatus').text()).toLowerCase() !== 'packed';
                if (filter === 'unknown-mass') return row.children('td').eq(3).text().trim() === '?';
                if (filter === 'cross-instance') return row.attr('data-cross-instance') === '1';
            }
            return false;
        }
        function applyProjectAssetFilters() {
            const query = $('#projectAssetRequirementSearch').val().trim().toLowerCase();
            const filter = $('#projectAssetRequirementFilter').val();
            const rows = $('#projectAssetRequirementsTableBody > tr[data-depth]');
            rows.removeClass('projectAssetFilterHidden').removeData('filter-include');
            if (!query && filter === 'all') return window.refreshAssetRequirementSections();
            rows.filter('[data-kind="requirement"], [data-kind="direct"], [data-kind="asset"]').each(function () {
                const row = $(this);
                const textMatch = !query || row.text().toLowerCase().indexOf(query) !== -1;
                row.data('filter-include', textMatch && projectAssetRowMatchesFilter(row, filter));
            });
            rows.filter('[data-kind="requirement"], [data-kind="direct"]').each(function () {
                const requirement = $(this);
                if (requirement.data('filter-include')) return;
                const childMatch = rows.filter('[data-kind="asset"][data-requirement-id="' + requirement.attr('data-id') + '"]').filter(function () { return $(this).data('filter-include'); }).length > 0;
                if (childMatch) requirement.data('filter-include', true);
            });
            // Walk sections from the bottom up so a nested match has already been
            // marked before its parent section is considered.
            $($(rows.filter('[data-kind="section"]').get().reverse())).each(function () {
                const section = $(this);
                const depth = parseInt(section.attr('data-depth'), 10) || 0;
                let next = section.next();
                let included = (!query || section.text().toLowerCase().indexOf(query) !== -1) && filter === 'all';
                while (next.length && (parseInt(next.attr('data-depth'), 10) || 0) > depth) { if (next.data('filter-include')) included = true; next = next.next(); }
                section.data('filter-include', included);
            });
            rows.each(function () { $(this).toggleClass('projectAssetFilterHidden', !$(this).data('filter-include')); });
            window.refreshAssetRequirementSections();
        }
        $('#projectAssetRequirementSearch').on('input', applyProjectAssetFilters);
        $('#projectAssetRequirementFilter').on('change', applyProjectAssetFilters);

        // Export from the live outline so the CSV reflects unsaved-to-page-state
        // background edits and preserves nesting through the Level column.
        function projectAssetExportRows() {
            const result = [['Kind', 'Level', 'Item', 'Status', 'Weight', 'Replacement value', 'Cost per unit', 'Discount', 'Total cost', 'Notes / details']];
