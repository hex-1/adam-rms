        $('#saveProjectPhysicalAsset').on('click', function () {
            const assignmentId = parseInt($('#editProjectPhysicalAssignmentId').val(), 10);
            const replacementId = $('#editProjectPhysicalReplacementGroup').is(':visible') ? parseInt($('#editProjectPhysicalReplacement').val(), 10) : 0;
            const requirementId = parseInt($('#editProjectPhysicalRequirementId').val(), 10);
            if (!assignmentId) return;
            const assetRow = $('#projectAssetRequirementsTableBody > .projectAssetPhysicalAsset[data-assignment-id="' + assignmentId + '"]');
            const finishSave = function () {
                $('#editProjectPhysicalAssetModal').modal('hide');
                if (replacementId && requirementId < 0) return location.reload();
                if (replacementId) loadAssetRequirementEditor(requirementId);
                window.refreshProjectAssetRequirementStatuses();
            };
            const saveReplacement = function () {
                if (!replacementId) return finishSave();
                ajaxcall('projects/assets/swap.php', {assetsAssignments_id: assignmentId, assets_id: replacementId}, finishSave, false);
            };
            {% if "PROJECTS:PROJECT_ASSETS:EDIT:ASSIGNMNET_COMMENT"|instancePermissions %}
            const comment = $('#editProjectPhysicalComment').val();
            ajaxcall('projects/assets/setComment.php', {assetsAssignments: [assignmentId], assetsAssignments_comment: comment}, function () {
                assetRow.attr('data-comment', comment);
                assetRow.find('.projectAssetPhysicalComment').empty().append(comment ? $('<i class="far fa-sticky-note mr-1"></i>') : null, document.createTextNode(comment));
                saveReplacement();
            }, false);
            {% else %}
            saveReplacement();
            {% endif %}
        });
        $('#projectAssetRequirementsTableBody').on('click', '.deleteAssetRequirement', function () {
            const requirementId = parseInt($(this).data('requirement-id'), 10);
            bootbox.confirm('Delete this planned asset requirement? Any allocated assets that have not reached Packed will be unassigned from the project.', function (confirmed) {
                if (!confirmed) return;
                const finishRequirementDelete = function () {
                    ajaxcall('projects/assets/deleteRequirement.php', {
                        projectAssetRequirements_id: requirementId,
                        finalize: 1
                    }, function () {
                    $('#projectAssetRequirement' + requirementId).remove();
                        $('#projectAssetRequirementsTableBody > .projectAssetPhysicalAsset[data-requirement-id="' + requirementId + '"]').remove();
                        window.refreshAssetRequirementSectionPackedTotals();
                    }, false);
                };
                ajaxcall('projects/assets/deleteRequirement.php', {projectAssetRequirements_id: requirementId}, function (check) {
                    const assignments = check.response.assignmentsToRemove || [];
                    if (!assignments.length) return finishRequirementDelete();
                    ajaxcall('projects/assets/unassign.php', {assetsAssignments: assignments}, finishRequirementDelete, false);
                }, false);
            });
        });
        $('#projectAssetRequirementsTableBody').on('click', '.addRequirementToSection', function () {
            const sectionId = String($(this).attr('data-section-id'));
            $('#addAssetRequirementSection').val(sectionId).trigger('change');
            $('#addAssetRequirementModal').modal('show');
            $('#addAssetRequirementModal').one('shown.bs.modal', function () {
                $('#addAssetRequirementType').select2('open');
            });
        });
        $('#projectAssetRequirementsTableBody').on('click', '.deleteAssetRequirementSection', function () {
            const sectionId = parseInt($(this).data('section-id'), 10);
            bootbox.confirm('Delete this section? Its contents will be moved up one level.', function (confirmed) {
                if (!confirmed) return;
                ajaxcall('projects/assets/deleteRequirementSection.php', {projectAssetRequirementSections_id: sectionId}, function () {
                    const sectionRow = $('#projectAssetRequirementsTableBody > [data-kind="section"][data-id="' + sectionId + '"]');
                    const sectionDepth = parseInt(sectionRow.attr('data-depth'), 10) || 0;
                    let row = sectionRow.next();
                    while (row.length && (parseInt(row.attr('data-depth'), 10) || 0) > sectionDepth) {
                        const newDepth = (parseInt(row.attr('data-depth'), 10) || 0) - 1;
                        row.attr('data-depth', newDepth).find('.projectAssetDragHandle').css('margin-left', (newDepth * 1.5) + 'rem');
                        row = row.next();
                    }
                    sectionRow.remove();
                    window.refreshAssetRequirementSections();
                    window.refreshAssetRequirementSectionPackedTotals();
                }, false);
            });
        });
    });
</script>
