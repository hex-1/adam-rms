                const oldDepth = parseInt(requirement.attr('data-depth'), 10) || 0;
                let group = requirement;
                let next = requirement.next();
                while (next.length && next.hasClass('projectAssetPhysicalAsset') && next.attr('data-requirement-id') === requirement.attr('data-id')) { group = group.add(next); next = next.next(); }
